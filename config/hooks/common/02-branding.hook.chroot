#!/bin/bash
# ============================================================
# TérangaOS — Branding hook
# Applies TérangaOS visual identity (all editions)
# ============================================================

set -e

echo "[TérangaOS] Applying branding..."

# --- 1. System information ---
cat > /etc/os-release << 'OSRELEASE'
PRETTY_NAME="TérangaOS 0.1 (Dakar)"
NAME="TérangaOS"
VERSION_ID="0.1"
VERSION="0.1 (Dakar)"
VERSION_CODENAME=Dakar
ID=terangaos
ID_LIKE=debian
HOME_URL="https://teranga-os.org"
SUPPORT_URL="https://teranga-os.org/support"
BUG_REPORT_URL="https://github.com/mdialloc19/teranga-os/issues"
PRIVACY_POLICY_URL="https://teranga-os.org/privacy"
OSRELEASE

# --- 2. Terminal welcome message ---
cat > /etc/update-motd.d/10-terangaos << 'MOTD'
#!/bin/bash
echo ""
echo "  🇸🇳 Welcome to TérangaOS"
echo "  Sovereign Linux Distribution for Senegal"
echo ""
echo "  Version  : $(cat /etc/os-release | grep VERSION= | cut -d'"' -f2)"
echo "  Kernel   : $(uname -r)"
echo "  Hostname : $(hostname)"
echo ""
echo "  📖 Documentation: https://teranga-os.org/docs"
echo "  🐛 Report a bug: https://github.com/mdialloc19/teranga-os/issues"
echo ""
MOTD
chmod +x /etc/update-motd.d/10-terangaos

# --- 3. Create branding folders ---
mkdir -p /usr/share/terangaos/wallpapers
mkdir -p /usr/share/terangaos/branding

echo "[TérangaOS] Branding applied ✓"
