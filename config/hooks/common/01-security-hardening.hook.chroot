#!/bin/bash
# ============================================================
# TérangaOS — Security hardening hook (post-installation)
# Hardens the system by default (all editions)
# ============================================================

set -e

echo "[TérangaOS] Applying security hardening..."

# --- 1. Enable UFW firewall (may fail in chroot — activates on first boot) ---
if command -v ufw &> /dev/null; then
    ufw default deny incoming 2>/dev/null || true
    ufw default allow outgoing 2>/dev/null || true
    ufw allow ssh 2>/dev/null || true
    ufw --force enable 2>/dev/null || true
    echo "[TérangaOS] ✓ UFW firewall configured"
fi

# --- 2. Enable AppArmor (skipped in chroot/container — applied on first boot) ---
if command -v aa-enforce &> /dev/null && [ -d /sys/kernel/security/apparmor ]; then
    aa-enforce /etc/apparmor.d/* 2>/dev/null || true
    echo "[TérangaOS] ✓ AppArmor enabled in enforce mode"
else
    echo "[TérangaOS] ⚠ AppArmor skipped (no kernel support — will apply on first boot)"
fi

# --- 3. Secure kernel parameters ---
cat >> /etc/sysctl.d/99-terangaos-security.conf << 'SYSCTL'
# TérangaOS — Kernel hardening

# Disable IP forwarding
net.ipv4.ip_forward = 0
net.ipv6.conf.all.forwarding = 0

# Spoofing protection
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1

# Ignore ICMP redirects
net.ipv4.conf.all.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0

# Ignore ICMP broadcast requests
net.ipv4.icmp_echo_ignore_broadcasts = 1

# SYN flood protection
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_max_syn_backlog = 2048
net.ipv4.tcp_synack_retries = 2

# Disable unsigned kernel modules
kernel.modules_disabled = 0

# Restrict dmesg to root users
kernel.dmesg_restrict = 1

# Restrict kernel pointers
kernel.kptr_restrict = 2

# Full ASLR
kernel.randomize_va_space = 2

# Restrict core dumps
fs.suid_dumpable = 0
SYSCTL
echo "[TérangaOS] ✓ Secure kernel parameters applied"

# --- 4. Disable unnecessary services ---
DISABLE_SERVICES=(
    avahi-daemon
    cups-browsed
)
for svc in "${DISABLE_SERVICES[@]}"; do
    systemctl disable "$svc" 2>/dev/null || true
done
echo "[TérangaOS] ✓ Unnecessary services disabled"

# --- 5. Sensitive file permissions ---
chmod 600 /etc/shadow
chmod 600 /etc/gshadow
chmod 644 /etc/passwd
chmod 644 /etc/group
echo "[TérangaOS] ✓ Sensitive file permissions fixed"

# --- 6. Login banner ---
cat > /etc/issue << 'BANNER'

  ╔═══════════════════════════════════════════════╗
  ║          🇸🇳  TérangaOS  🇸🇳                   ║
  ║  Sovereign system — Authorized access only ║
  ║  All activity is monitored and logged ║
  ╚═══════════════════════════════════════════════╝

BANNER
echo "[TérangaOS] ✓ Login banner configured"

# --- 7. Configure automatic security updates ---
cat > /etc/apt/apt.conf.d/50unattended-upgrades << 'AUTOUPDATE'
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}-security";
};
Unattended-Upgrade::AutoFixInterruptedDpkg "true";
Unattended-Upgrade::MinimalSteps "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Automatic-Reboot "false";
AUTOUPDATE
echo "[TérangaOS] ✓ Automatic security updates configured"

echo "[TérangaOS] Security hardening complete ✓"
