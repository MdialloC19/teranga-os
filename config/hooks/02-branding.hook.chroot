#!/bin/bash
# ============================================================
# TérangaOS — Hook de branding
# Applique l'identité visuelle TérangaOS
# ============================================================

set -e

echo "[TérangaOS] Application du branding..."

# --- 1. Informations système ---
cat > /etc/os-release << 'OSRELEASE'
PRETTY_NAME="TérangaOS 0.1 (Dakar)"
NAME="TérangaOS"
VERSION_ID="0.1"
VERSION="0.1 (Dakar)"
VERSION_CODENAME=Dakar
ID=terangaos
ID_LIKE=debian
HOME_URL="https://teranga-os.org"
SUPPORT_URL="https://teranga-os.org/support"
BUG_REPORT_URL="https://github.com/mdialloc19/teranga-os/issues"
PRIVACY_POLICY_URL="https://teranga-os.org/privacy"
OSRELEASE

# --- 2. Message de bienvenue terminal ---
cat > /etc/update-motd.d/10-terangaos << 'MOTD'
#!/bin/bash
echo ""
echo "  🇸🇳 Bienvenue sur TérangaOS"
echo "  Distribution Linux souveraine pour le Sénégal"
echo ""
echo "  Version  : $(cat /etc/os-release | grep VERSION= | cut -d'"' -f2)"
echo "  Kernel   : $(uname -r)"
echo "  Hostname : $(hostname)"
echo ""
echo "  📖 Documentation : https://teranga-os.org/docs"
echo "  🐛 Signaler un bug : https://github.com/mdialloc19/teranga-os/issues"
echo ""
MOTD
chmod +x /etc/update-motd.d/10-terangaos

# --- 3. Créer les dossiers de branding ---
mkdir -p /usr/share/terangaos/wallpapers
mkdir -p /usr/share/terangaos/branding

echo "[TérangaOS] Branding appliqué ✓"
