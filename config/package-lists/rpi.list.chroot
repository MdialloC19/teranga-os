# ============================================================
# TérangaOS RPi — Packages for Raspberry Pi 5
# Optimized Xfce desktop for ARM64
# Minimum RAM: 2 GB (recommended: 4-8 GB)
# ============================================================

# --- Xfce Desktop (lightweight, smooth on RPi) ---
task-xfce-desktop
xfce4
xfce4-goodies
xfce4-terminal
xfce4-power-manager
xfce4-notifyd
xfce4-screenshooter
xfce4-taskmanager
xfce4-whiskermenu-plugin
xfce4-clipman-plugin
xfce4-pulseaudio-plugin
lightdm
lightdm-gtk-greeter
lightdm-gtk-greeter-settings

# --- File manager ---
thunar
thunar-archive-plugin
thunar-volman

# --- Office suite ---
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-l10n-fr
libreoffice-help-fr
libreoffice-gtk3

# --- Browser ---
firefox-esr
firefox-esr-l10n-fr

# --- Email ---
thunderbird
thunderbird-l10n-fr

# --- Messaging ---
# Element Desktop will be installed via script (not in Debian ARM repos)

